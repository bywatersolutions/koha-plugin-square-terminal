[% USE KohaDates %]
[% INCLUDE 'doc-head-open.inc' %]
<title>Koha: Square Terminal Plugin: Configuration</title>
[% INCLUDE 'doc-head-close.inc' %]
</head>

<body>
[% INCLUDE 'header.inc' %]
[% INCLUDE 'cat-search.inc' %]

<div id="breadcrumbs">
  <a href="/cgi-bin/koha/mainpage.pl">Home</a> &rsaquo;
  <a href="/cgi-bin/koha/plugins/plugins-home.pl">Plugins</a> &rsaquo;
  Square Terminal &rsaquo;
  Configuration
</div>

<div id="doc3">
  <form method="get" class="form">
    <input type="hidden" name="class" value="[% CLASS %]" />
    <input type="hidden" name="method" value="[% METHOD %]" />
    <input type="hidden" name="save" value="1" />

    <fieldset>
      <legend>Square Terminal configuration</legend>

      <div class="row">
        <div class="col-md-6">
          <div class="form-group">
            <label for="SquareAccessToken">Square access token</label>
            <input
              type="password"
              class="form-control"
              id="SquareAccessToken"
              name="SquareAccessToken"
              value="[% SquareAccessToken | html %]"
              autocomplete="off"
              aria-describedby="SquareAccessTokenHelp"
            />
            <small id="SquareAccessTokenHelp" class="hint">
              Store a Square sandbox or production access token here. Treat this like a password.
            </small>
          </div>

          <div class="form-group">
            <label for="Currency">Currency</label>
            <input
              type="text"
              class="form-control"
              id="Currency"
              name="Currency"
              value="[% Currency | html %]"
              aria-describedby="CurrencyHelp"
            />
            <small id="CurrencyHelp" class="hint">
              ISO currency code, e.g. <code>USD</code>.
            </small>
          </div>

          <div class="form-group">
            <label for="SquareVersion">Square API version</label>
            <input
              type="text"
              class="form-control"
              id="SquareVersion"
              name="SquareVersion"
              value="[% SquareVersion | html %]"
              aria-describedby="SquareVersionHelp"
            />
            <small id="SquareVersionHelp" class="hint">
              Optional. If unsure, leave the default.
            </small>
          </div>
        </div>

        <div class="col-md-6">
          <div class="form-group">
            <label for="WebhookUrl">Webhook URL</label>
            <input
              type="text"
              class="form-control"
              id="WebhookUrl"
              name="WebhookUrl"
              value="[% WebhookUrl | html %]"
              aria-describedby="WebhookUrlHelp"
            />
            <small id="WebhookUrlHelp" class="hint">
              The public HTTPS URL Square will POST events to (we’ll use this when webhook handling is added).
            </small>
          </div>

          <div class="form-group">
            <label for="WebhookSignatureKey">Webhook signature key</label>
            <input
              type="password"
              class="form-control"
              id="WebhookSignatureKey"
              name="WebhookSignatureKey"
              value="[% WebhookSignatureKey | html %]"
              autocomplete="off"
              aria-describedby="WebhookSignatureKeyHelp"
            />
            <small id="WebhookSignatureKeyHelp" class="hint">
              Used to validate Square webhook signatures.
            </small>
          </div>
        </div>
      </div>

      <hr />

      <div class="form-group">
        <label for="RegisterMapping">Register → Square device mapping</label>
        <textarea
          class="form-control"
          id="RegisterMapping"
          name="RegisterMapping"
          rows="10"
          aria-describedby="RegisterMappingHelp"
        >[% RegisterMapping | html %]</textarea>

        <small id="RegisterMappingHelp" class="hint">
          YAML mapping of Koha register IDs to Square <code>device_id</code> values. Example:
          <pre>
1: "DEVICE_ID_FOR_REGISTER_1"
3: "DEVICE_ID_FOR_REGISTER_3"
          </pre>
        </small>
      </div>

    </fieldset>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save configuration</button>
      <a class="btn btn-default" href="/cgi-bin/koha/plugins/plugins-home.pl">Cancel</a>
    </div>
  </form>
</div>

[% INCLUDE 'intranet-bottom.inc' %]
