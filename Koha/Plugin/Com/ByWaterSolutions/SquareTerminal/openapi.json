{
  "/get_debits/{accountlines}": {
    "get": {
      "x-mojo-to": "Com::ByWaterSolutions::SquareTerminal::API#get_debits",
      "operationId": "GetDebits",
      "tags": ["square_terminal"],
      "parameters": [
        {
          "name": "accountlines",
          "in": "path",
          "description": "List of comma separated accountline ids",
          "required": true,
          "type": "string"
        }
      ],
      "produces": ["application/json"],
      "responses": {
        "200": { "description": "JSON data of accountlines + computed total" },
        "400": { "description": "Bad request" }
      }
    }
  },

  "/checkout/{accountlines}": {
    "post": {
      "x-mojo-to": "Com::ByWaterSolutions::SquareTerminal::API#create_checkout",
      "operationId": "CreateCheckout",
      "tags": ["square_terminal"],
      "parameters": [
        {
          "name": "accountlines",
          "in": "path",
          "description": "List of comma separated accountline ids",
          "required": true,
          "type": "string"
        },
        {
          "name": "amount",
          "in": "query",
          "description": "Optional integer amount in cents. If omitted, server computes from outstanding balances.",
          "required": false,
          "type": "integer"
        }
      ],
      "produces": ["application/json"],
      "responses": {
        "200": { "description": "Square checkout created" },
        "400": { "description": "Bad request" },
        "404": { "description": "No mapped Square device for this register" },
        "500": { "description": "Configuration error" }
      }
    }
  },

  "/checkout/pos": {
    "post": {
      "x-mojo-to": "Com::ByWaterSolutions::SquareTerminal::API#create_pos_checkout",
      "operationId": "CreatePosCheckout",
      "tags": ["square_terminal"],
      "parameters": [
        {
          "name": "amount",
          "in": "query",
          "description": "Required integer amount in cents for the POS sale total.",
          "required": true,
          "type": "integer"
        },
        {
          "name": "register_id",
          "in": "query",
          "description": "Koha cash register id selected on the POS page.",
          "required": true,
          "type": "integer"
        }
      ],
      "produces": ["application/json"],
      "responses": {
        "200": { "description": "Square POS checkout created" },
        "400": { "description": "Bad request" },
        "404": { "description": "No mapped Square device for this register" },
        "500": { "description": "Configuration error" }
      }
    }
  },

  "/checkout/status/{checkout_id}": {
    "get": {
      "x-mojo-to": "Com::ByWaterSolutions::SquareTerminal::API#get_checkout",
      "operationId": "GetCheckout",
      "tags": ["square_terminal"],
      "parameters": [
        {
          "name": "checkout_id",
          "in": "path",
          "description": "Square terminal checkout id",
          "required": true,
          "type": "string"
        }
      ],
      "produces": ["application/json"],
      "responses": {
        "200": { "description": "Square checkout status response" },
        "400": { "description": "Bad request" },
        "500": { "description": "Configuration error" }
      }
    }
  },

  "/checkout/dismiss/{checkout_id}": {
    "post": {
      "x-mojo-to": "Com::ByWaterSolutions::SquareTerminal::API#dismiss_checkout",
      "operationId": "DismissCheckout",
      "tags": ["square_terminal"],
      "parameters": [
        {
          "name": "checkout_id",
          "in": "path",
          "description": "Square terminal checkout id",
          "required": true,
          "type": "string"
        }
      ],
      "produces": ["application/json"],
      "responses": {
        "200": { "description": "Dismiss request accepted" },
        "400": { "description": "Bad request" },
        "500": { "description": "Configuration error" }
      }
    }
  },

  "/checkout/finalize/{checkout_id}/{accountlines}": {
    "post": {
      "x-mojo-to": "Com::ByWaterSolutions::SquareTerminal::API#finalize_checkout",
      "operationId": "FinalizeCheckout",
      "tags": ["square_terminal"],
      "parameters": [
        {
          "name": "checkout_id",
          "in": "path",
          "description": "Square terminal checkout id",
          "required": true,
          "type": "string"
        },
        {
          "name": "accountlines",
          "in": "path",
          "description": "List of comma separated accountline ids to pay (server will pay outstanding on these lines)",
          "required": true,
          "type": "string"
        }
      ],
      "produces": ["application/json"],
      "responses": {
        "200": { "description": "Koha payment created and applied to selected lines" },
        "400": { "description": "Bad request" },
        "409": { "description": "Checkout not completed yet" },
        "500": { "description": "Configuration error" }
      }
    }
  }
}
